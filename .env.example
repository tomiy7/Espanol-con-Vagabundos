# Database
DB_PASSWORD=changeme

# JWT
JWT_SECRET=changeme_minimum_32_chars

# RabbitMQ (UI: http://localhost:15672)
RABBITMQ_USER=coursesite
RABBITMQ_PASSWORD=changeme

# Notifications: SMTP (lokalno mailpit, bez lozinke - mejlovi se vide na http://localhost:8025),
# admin token za citanje mejla korisnika iz Auth-a, adresa fronta za linkove u mejlovima
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USE_SSL=false
SMTP_USER=
SMTP_PASSWORD=
# Adresa posiljaoca: sa pravim provajderom mora biti sa vaseg domena (SPF/DKIM),
# za Gmail test - isti Gmail nalog kao SMTP_USER
SMTP_FROM=no-reply@espanolconvagabundos.local
SMTP_FROM_NAME=Español con Vagabundos
AUTH_SERVICE_ADMIN_TOKEN=
FRONTEND_BASE_URL=http://localhost:3000
NOTIFICATIONS_DB_PORT=5438

# Host portovi za Groups (opciono; podrazumevano 5435 i 5003)
GROUPS_DB_PORT=5435
GROUPS_API_PORT=5003

# Directus
DIRECTUS_ADMIN_EMAIL=changeme
DIRECTUS_ADMIN_PASSWORD=changeme_secret